{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["jest"],
    "paths": {
      "@shared/*": ["../src/shared/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../electron/services/database/migrations/list.ts"
  ],
  "exclude": ["node_modules", "android", "ios"]
}
