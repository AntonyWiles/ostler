{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@shared/*": ["../src/shared/*"],
      "@renderer/*": ["../src/renderer/*"]
    }
  },
  "include": [
    "../electron/**/*.ts",
    "../src/shared/**/*.ts",
    "../src/shared/templates/**/*.json",
    "../src/shared/locales/**/*.json",
    "../tests/unit/**/*.ts",
    "../tests/integration/**/*.ts",
    "../mobile/src/sync/phone-sync.ts"
  ]
}
